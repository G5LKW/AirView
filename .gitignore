# Build outputs and release artifacts
/dist/
*.exe
*.exe~
*.test
*.test.exe
*.out
*.prof
/airview
/airview-feeder
deploy/installer/out/
docs/manual/build/out/
docs/manual/*.pdf

# Runtime data folders (created when the app runs from the source tree)
/data/
**/data/airview.db*
*.db
*.db-wal
*.db-shm
# test fixtures (e.g. the AirView 1.0.0 database for cmd/airview TestDBMigrateOldFormat) are committed
!cmd/airview/testdata/*.db
*.log
*.log.[0-9]
window.json
webview2/
tilecache/

# Secrets — release signing keys never live in the repository
*.key
*.pem
release-keys/

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
